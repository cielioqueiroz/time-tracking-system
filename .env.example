# ─────────────────────────────────────────────────────────────────────────
#  Copy to `.env` and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────

# Database
DB_NAME=timetracking
DB_USERNAME=timetracking
DB_PASSWORD=timetracking
DB_PORT=5432

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend (container Docker, profile `full`)
FRONTEND_PORT=8081
# URL da API que o navegador usa (build do Flutter web). Para Docker local, mantenha localhost.
API_BASE_URL=http://localhost:8080

# JWT (use a strong 256-bit+ secret in production)
JWT_SECRET=change-me-in-production-this-must-be-at-least-256-bits-long-secret
JWT_EXPIRATION=86400000
